{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "A Kanban board that spawns AI coding agents in isolated git worktrees, one per ticket.",
  "author": "InputForge",
  "type": "module",
  "main": "out/electron/main.js",
  "scripts": {
    "clean": "rm -rf dist/ out/",
    "dev": "concurrently -n vite,electron -c magenta,cyan \"bun run dev:frontend\" \"bun run dev:electron\"",
    "dev:frontend": "vite",
    "dev:electron": "bun run build:electron && AGENTFORGE_DEV=1 electron .",
    "dev:electron:clean": "bun run build:electron && env -i HOME=\"$HOME\" USER=\"$USER\" SHELL=\"$SHELL\" PATH=/usr/bin:/bin:/usr/sbin:/sbin AGENTFORGE_DEV=1 ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "build:frontend": "vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "build": "bun run build:frontend && bun run build:electron",
    "start": "electron .",
    "package:dir": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "package:mac": "bun run build && electron-builder --mac",
    "typecheck:frontend": "tsc --build src/frontend/tsconfig.json",
    "typecheck:backend": "tsc --build src/backend/tsconfig.json",
    "typecheck:common": "tsc --build src/common/tsconfig.json",
    "typecheck:electron": "tsc --build src/electron/tsconfig.json",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxfmt --check . && oxlint .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "bun scripts/fix-node-pty.ts",
    "prepare": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.32.0",
    "@agentclientprotocol/sdk": "^0.21.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@pierre/diffs": "^1.2.2",
    "@tailwindcss/vite": "4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.8.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "tailwindcss": "4.3.2",
    "zod": "^4.3.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "^9.0.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.5.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
