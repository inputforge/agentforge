# Dependencies
node_modules/

# Build output
# Renderer bundle (out/client) + bundled main & preload (out/electron) + tsc
# declarations (out/types). All generated by `bun run build`.
/out/
# electron-builder output (.app, .zip, .dmg)
/dist/

# TypeScript incremental build cache — one per project reference (src/common,
# src/frontend, src/backend, src/electron).
*.tsbuildinfo

# Vitest coverage
coverage/

# Vite's config reload stamps
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
*.log
logs/

# Environment overrides. API keys come from the shell environment — the agent CLIs
# (claude, codex) already read them from your shell profile.
.env
.env.*
!.env.example

# macOS Finder metadata
.DS_Store

# AgentForge's per-repo state: SQLite db + agent worktrees. Written into whichever
# repo is opened, including this one when dogfooding.
/.agentforge/
